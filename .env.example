# Backend
PORT=43128
DATA_DIR=./data
# Required for production servers (npm start / Docker / Fly).
# Electron desktop (`npm run desktop`) defaults to trivia-local when unset.
# HOST_PASSCODE=change-me

# Optional AI (also configurable in Settings)
# MISTRAL_API_KEY=
# ANTHROPIC_API_KEY=
# ANTHROPIC_WORKSPACE_ID=

# Frontend (dev)
# VITE_BACKEND_URL=http://localhost:43128

# Apple Music (Phase 5) — optional; core quiz works without these
# APPLE_MUSIC_TEAM_ID=
# APPLE_MUSIC_KEY_ID=
# APPLE_MUSIC_PRIVATE_KEY_PATH=
# APPLE_MUSIC_TOKEN=
